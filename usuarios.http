# Instale a extensão REST Client no VS Code.
# Execute cada requisição em ordem pelo botão "Send Request".
@usuarios = http://localhost:3001

### 1. Healthcheck: 200
GET {{usuarios}}/health

### 2. Cadastro de usuário: 201
# @name novoUsuario
POST {{usuarios}}/usuarios
Content-Type: application/json

{
  "nome": "Ana de Teste",
  "email": "ana.teste@loja.com",
  "senha": "segredo123"
}

### 3. Cadastro repetido: 409 (execute após a requisição 2)
POST {{usuarios}}/usuarios
Content-Type: application/json

{
  "nome": "Ana de Teste",
  "email": "ana.teste@loja.com",
  "senha": "segredo123"
}

### 4. Cadastro inválido: 400
POST {{usuarios}}/usuarios
Content-Type: application/json

{ "nome": "X", "email": "invalido", "senha": "12" }

### 5. Login do cliente seed: 200
# @name loginCliente
POST {{usuarios}}/auth/login
Content-Type: application/json

{ "email": "cliente@loja.com", "senha": "cliente123" }

### 6. Login inválido: 401
POST {{usuarios}}/auth/login
Content-Type: application/json

{ "email": "cliente@loja.com", "senha": "senha-errada" }

### 7. Meus dados: 200
GET {{usuarios}}/usuarios/me
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 8. Meus dados sem token: 401
GET {{usuarios}}/usuarios/me

### 9. Atualizar meus dados: 200
PUT {{usuarios}}/usuarios/me
Content-Type: application/json
Authorization: Bearer {{loginCliente.response.body.$.token}}

{ "nome": "Cliente Atualizado", "email": "cliente@loja.com" }

### 10. Atualização inválida: 400
PUT {{usuarios}}/usuarios/me
Content-Type: application/json
Authorization: Bearer {{loginCliente.response.body.$.token}}

{ "nome": "X", "email": "errado" }

### 11. Endereços do cliente seed: 200 (pelo menos um endereço)
GET {{usuarios}}/usuarios/me/enderecos
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 12. Criar endereço: 201
# @name criarEndereco
POST {{usuarios}}/usuarios/me/enderecos
Content-Type: application/json
Authorization: Bearer {{loginCliente.response.body.$.token}}

{
  "apelido": "Trabalho",
  "cep": "97000-001",
  "logradouro": "Rua das Flores",
  "numero": "25",
  "complemento": "Sala 2",
  "cidade": "Santa Maria",
  "uf": "RS",
  "principal": false
}

### 13. Endereço inválido: 400
POST {{usuarios}}/usuarios/me/enderecos
Content-Type: application/json
Authorization: Bearer {{loginCliente.response.body.$.token}}

{ "cep": "123", "logradouro": "", "cidade": "", "uf": "XXXY" }

### 14. Excluir endereço criado: 204
DELETE {{usuarios}}/usuarios/me/enderecos/{{criarEndereco.response.body.$.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 15. Excluir endereço inexistente: 404
DELETE {{usuarios}}/usuarios/me/enderecos/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 16. Cliente tenta listar usuários: 403
GET {{usuarios}}/usuarios
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 17. Login do admin seed: 200
# @name loginAdmin
POST {{usuarios}}/auth/login
Content-Type: application/json

{ "email": "admin@loja.com", "senha": "admin123" }

### 18. Admin lista usuários: 200 (sem senha_hash)
GET {{usuarios}}/usuarios
Authorization: Bearer {{loginAdmin.response.body.$.token}}
