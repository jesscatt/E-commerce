# OPCIONAL. O docker-compose.yml já tem valores padrão para tudo: num clone novo,
# "docker compose up -d --build" sobe sem este arquivo.
# Crie um .env (cp .env.example .env) só se quiser trocar algum valor.
POSTGRES_DB=usuarios_db
POSTGRES_USER=loja
POSTGRES_PASSWORD=loja-senha-dev
# Pelo menos 32 caracteres, só letras, números e hífen (o valor é copiado para o kong.yml).
JWT_SECRET=ecommerce-amf-segredo-jwt-de-desenvolvimento
